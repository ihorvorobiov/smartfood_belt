<!DOCTYPE html>
<html lang="uk"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Smart Food — Collection</title>
<style>
@property --accent{syntax:'<color>';inherits:true;initial-value:#6e3412}
:root{--accent:#6e3412;--bg:#f6f5f3;--ink:#1d1d1f;--mut:#6e6e73;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);transition:--accent .9s cubic-bezier(.2,.7,.2,1)}
*{box-sizing:border-box;margin:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Inter","Segoe UI",Roboto,Helvetica,Arial,sans-serif;overflow:hidden;display:flex;flex-direction:column;align-items:center;position:relative;touch-action:pan-y}
.glow{position:fixed;inset:-20%;background:radial-gradient(48% 42% at 50% 46%,var(--accent),transparent 70%);opacity:.20;transition:opacity 1s;pointer-events:none;filter:blur(30px)}
header{width:100%;padding:18px 24px 0;display:flex;justify-content:center;font-size:12px;letter-spacing:.32em;text-transform:uppercase;color:var(--mut);font-weight:600;position:relative}
.head{position:relative;text-align:center;padding:2vh 20px 0;min-height:clamp(92px,17vh,150px);width:100%}
.head>div{position:absolute;left:0;right:0;top:2vh;opacity:0;transform:translateY(16px);filter:blur(8px);transition:all .8s cubic-bezier(.2,.7,.2,1);pointer-events:none}
.head>div.on{opacity:1;transform:none;filter:none}
h1{font-size:clamp(34px,7.2vw,80px);line-height:1.02;font-weight:700;letter-spacing:-.035em;background:linear-gradient(180deg,var(--ink) 30%,color-mix(in srgb,var(--accent) 80%,#000));-webkit-background-clip:text;background-clip:text;color:transparent}
.head p{margin-top:8px;font-size:clamp(14px,2vw,19px);color:var(--mut);letter-spacing:-.01em}
.stage{flex:1;min-height:0;width:min(100%,860px);position:relative;perspective:1200px;margin-top:6px}
.box{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:0;height:0;filter:drop-shadow(0 28px 26px rgba(0,0,0,.17)) drop-shadow(0 5px 7px rgba(0,0,0,.1))}
.box.t{transition:width 1.1s cubic-bezier(.3,.75,.2,1),height 1.1s cubic-bezier(.3,.75,.2,1)}
.box img{position:absolute;inset:0;width:100%;height:100%;object-fit:fill;opacity:0;transition:opacity .75s ease;user-select:none;-webkit-user-drag:none}
.box img.on{opacity:1}
.ui{width:100%;padding:6px 16px 18px;display:flex;flex-direction:column;align-items:center;gap:14px}
.seg{position:relative;display:flex;background:rgba(120,120,128,.14);border-radius:999px;padding:4px;backdrop-filter:blur(14px)}
.seg button{position:relative;z-index:1;border:0;background:none;font:600 14px/1 inherit;font-family:inherit;color:var(--mut);padding:11px 20px;border-radius:999px;cursor:pointer;transition:color .3s}
.seg button.on{color:var(--ink)}
.pill{position:absolute;top:4px;bottom:4px;left:0;border-radius:999px;background:#fff;box-shadow:0 2px 10px rgba(0,0,0,.12);transition:transform .55s cubic-bezier(.2,.8,.2,1),width .55s cubic-bezier(.2,.8,.2,1)}
.belts{display:flex;gap:10px;align-items:center}
.belts button{display:flex;align-items:center;gap:0;border:0;cursor:pointer;background:rgba(255,255,255,.7);border-radius:999px;padding:6px;font:600 13px/1 inherit;font-family:inherit;color:var(--ink);box-shadow:0 0 0 1px rgba(0,0,0,.06);transition:all .5s cubic-bezier(.2,.8,.2,1);backdrop-filter:blur(10px)}
.belts i{width:26px;height:26px;border-radius:50%;background:var(--c);flex:none;box-shadow:inset 0 0 0 2px rgba(255,255,255,.35)}
.belts span{max-width:0;overflow:hidden;white-space:nowrap;opacity:0;transition:all .5s cubic-bezier(.2,.8,.2,1)}
.belts button.on{padding-right:14px;box-shadow:0 0 0 2px var(--c)}
.belts button.on span{max-width:150px;opacity:1;margin-left:9px}
@media(max-width:520px){.belts{gap:7px}.seg button{padding:10px 15px}.belts button.on span{max-width:110px;font-size:12px}}
.reveal{opacity:0;transform:translateY(24px);animation:in 1.1s cubic-bezier(.2,.7,.2,1) forwards}
@keyframes in{to{opacity:1;transform:none}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition-duration:.01s!important}.reveal{opacity:1;transform:none}}
</style></head><body>
<div class="glow"></div>
<header class="reveal">Smart Food</header>
<div class="head reveal" style="animation-delay:.15s" id="head"></div>
<div class="stage reveal" style="animation-delay:.3s" id="stage"><div class="box" id="tilt"></div></div>
<div class="ui reveal" style="animation-delay:.5s">
 <div class="seg" id="seg"><div class="pill" id="pill"></div></div>
 <div class="belts" id="belts"></div>
</div>
<script>
const IMGS={"big_1": "data:image/webp;base64,", "big_2": "data:image/webp;base64,", "big_3": "data:image/webp;base64,", "big_4": "data:image/webp;base64,", "middle_1": "data:image/webp;base64,", "middle_2": "data:image/webp;base64,", "middle_3": "data:image/webp;base64,", "middle_4": "data:image/webp;base64,", "small_1": "data:image/webp;base64,", "small_2": "data:image/webp;base64,", "small_3": "data:image/webp;base64,", "small_4": "data:image/webp;base64,"};
const SIZES=[['big','Велика'],['middle','Середня'],['small','Мала']];
const BELTS=[
 {n:'Collection',t:'Collection',s:'Класика Smart Food в шоколаді',c:'#6e3412'},
 {n:'Фрукти та ягоди',t:'Фрукти та ягоди',s:'Яскравий смак натуральних інгредієнтів',c:'#9b1b3f'},
 {n:'Горіхи',t:'Горіхи',s:'Хрусткий смак, що заряджає енергією',c:'#55882a'},
 {n:'Мікс смаків',t:'Мікс смаків',s:'Усі улюблені смаки в одній коробці',c:'#6a3485'}];
let size=0,belt=0;
const $=id=>document.getElementById(id),tilt=$('tilt'),seg=$('seg'),pill=$('pill'),head=$('head'),belts=$('belts');
const DIMS=[[937,1374],[1015,1040],[947,950]];
const imgs=SIZES.map(([k])=>BELTS.map((b,j)=>{const im=new Image();im.src=IMGS[k+'_'+(j+1)];im.alt=b.n;im.draggable=false;tilt.appendChild(im);return im}));
function fit(){const r=$('stage').getBoundingClientRect(),k=Math.min(r.width*.9/1015,r.height*.92/1374);tilt.style.width=DIMS[size][0]*k+'px';tilt.style.height=DIMS[size][1]*k+'px'}
SIZES.forEach(([k,l],i)=>{const b=document.createElement('button');b.textContent=l;b.onclick=()=>setSize(i);seg.appendChild(b)});
BELTS.forEach((b,i)=>{const e=document.createElement('button');e.style.setProperty('--c',b.c);e.setAttribute('aria-label',b.n);e.innerHTML='<i></i><span>'+b.n+'</span>';e.onclick=()=>setBelt(i);belts.appendChild(e);
 const h=document.createElement('div');h.innerHTML='<h1>'+b.t+'</h1><p>'+b.s+'</p>';head.appendChild(h)});
function render(){
 fit();imgs.forEach((a,i)=>a.forEach((im,j)=>im.classList.toggle('on',i===size&&j===belt)));
 [...head.children].forEach((h,i)=>h.classList.toggle('on',i===belt));
 [...belts.children].forEach((b,i)=>b.classList.toggle('on',i===belt));
 const bs=[...seg.querySelectorAll('button')];bs.forEach((b,i)=>b.classList.toggle('on',i===size));
 const a=bs[size];pill.style.width=a.offsetWidth+'px';pill.style.transform='translateX('+(a.offsetLeft-4)+'px)';
 document.documentElement.style.setProperty('--accent',BELTS[belt].c);
}
function setSize(i){size=i;render()}
function setBelt(i){belt=(i+BELTS.length)%BELTS.length;render()}
render();addEventListener('resize',render);document.fonts&&document.fonts.ready.then(render);
const st=$('stage');
requestAnimationFrame(()=>requestAnimationFrame(()=>tilt.classList.add('t')));
// swipe
let sx=null;st.addEventListener('touchstart',e=>sx=e.touches[0].clientX,{passive:true});
st.addEventListener('touchend',e=>{if(sx===null)return;const d=e.changedTouches[0].clientX-sx;if(Math.abs(d)>40)setBelt(belt+(d<0?1:-1));sx=null});
addEventListener('keydown',e=>{if(e.key==='ArrowRight')setBelt(belt+1);if(e.key==='ArrowLeft')setBelt(belt-1)});
</script></body></html>
